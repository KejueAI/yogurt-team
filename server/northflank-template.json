{
  "apiVersion": "v1.2",
  "name": "yogurt-team",
  "description": "Yogurt Team server: project, Postgres 17 addon, secret group linking the addon to DATABASE_URL, and a combined service built from server/Dockerfile. Not validated against the Northflank API; review before running.",
  "arguments": {
    "PROJECT_NAME": "yogurt-team",
    "PROJECT_REGION": "europe-west",
    "GIT_BRANCH": "main",
    "PUBLIC_URL": "",
    "GOOGLE_CLIENT_ID": "",
    "GOOGLE_CLIENT_SECRET": "",
    "SECRET_KEY": "",
    "ADMIN_EMAILS": "",
    "ALLOWED_DOMAINS": ""
  },
  "spec": {
    "kind": "Workflow",
    "spec": {
      "type": "sequential",
      "steps": [
        {
          "kind": "Project",
          "ref": "project",
          "spec": {
            "name": "${args.PROJECT_NAME}",
            "region": "${args.PROJECT_REGION}",
            "color": "#F5D76E"
          }
        },
        {
          "kind": "Workflow",
          "spec": {
            "type": "sequential",
            "context": { "projectId": "${refs.project.id}" },
            "steps": [
              {
                "kind": "Addon",
                "ref": "database",
                "spec": {
                  "name": "yogurt-db",
                  "type": "postgresql",
                  "version": "17",
                  "billing": {
                    "deploymentPlan": "nf-compute-20",
                    "storage": 4096,
                    "replicas": 1
                  },
                  "tlsEnabled": false,
                  "externalAccessEnabled": false
                }
              },
              {
                "kind": "SecretGroup",
                "ref": "secrets",
                "spec": {
                  "name": "yogurt-server-secrets",
                  "type": "secret",
                  "secretType": "environment",
                  "priority": 10,
                  "secrets": {
                    "variables": {
                      "NODE_ENV": "production",
                      "PORT": "8080",
                      "PUBLIC_URL": "${args.PUBLIC_URL}",
                      "GOOGLE_CLIENT_ID": "${args.GOOGLE_CLIENT_ID}",
                      "GOOGLE_CLIENT_SECRET": "${args.GOOGLE_CLIENT_SECRET}",
                      "SECRET_KEY": "${args.SECRET_KEY}",
                      "ADMIN_EMAILS": "${args.ADMIN_EMAILS}",
                      "ALLOWED_DOMAINS": "${args.ALLOWED_DOMAINS}"
                    },
                    "files": {}
                  },
                  "addonDependencies": [
                    {
                      "addonId": "${refs.database.id}",
                      "keys": [{ "keyName": "POSTGRES_URI", "aliases": ["DATABASE_URL"] }]
                    }
                  ]
                }
              },
              {
                "kind": "CombinedService",
                "ref": "server",
                "spec": {
                  "name": "yogurt-server",
                  "billing": { "deploymentPlan": "nf-compute-20" },
                  "vcsData": {
                    "projectType": "github",
                    "projectUrl": "https://github.com/Youssef-Abdelsalam-2005/yogurt-team",
                    "projectBranch": "${args.GIT_BRANCH}"
                  },
                  "buildSettings": {
                    "dockerfile": {
                      "buildEngine": "buildkit",
                      "dockerFilePath": "/server/Dockerfile",
                      "dockerWorkDir": "/server"
                    }
                  },
                  "buildConfiguration": {
                    "pathIgnoreRules": ["/app/**", "/site/**"],
                    "isAllowList": false
                  },
                  "deployment": {
                    "instances": 1,
                    "docker": { "configType": "default" }
                  },
                  "ports": [
                    { "name": "http", "internalPort": 8080, "protocol": "HTTP", "public": true }
                  ],
                  "healthChecks": [
                    {
                      "protocol": "HTTP",
                      "type": "readinessProbe",
                      "port": 8080,
                      "path": "/healthz",
                      "initialDelaySeconds": 5,
                      "periodSeconds": 10,
                      "timeoutSeconds": 3,
                      "failureThreshold": 3,
                      "successThreshold": 1
                    },
                    {
                      "protocol": "HTTP",
                      "type": "livenessProbe",
                      "port": 8080,
                      "path": "/healthz",
                      "initialDelaySeconds": 20,
                      "periodSeconds": 30,
                      "timeoutSeconds": 5,
                      "failureThreshold": 3,
                      "successThreshold": 1
                    }
                  ],
                  "runtimeEnvironment": {}
                }
              }
            ]
          }
        }
      ]
    }
  }
}
